<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e7da-c788-8000-d625-01ef9001ef90_29384</versionUuid>
    <rule>
        <name>TM_buildTransactionStarts</name>
        <uuid>_a-0000e398-8061-8000-8592-01ef9001ef90_104323</uuid>
        <description>Builds TM_TransactionStart Objects Required To Initiate The Transaction Process Instances</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289262</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>#"SYSTEM_SYSRULES_forEach"(
  items: merge(
    ri!modelUuids,
    ri!transactionIds,
    ri!contextJSONs
  ),
  expression: a!localVariables(
    local!modelId: displayvalue(
      fv!item[1],
      ri!models.uuid,
      ri!models.id,
      null
    ),
    local!isJsonEmpty: or(
      isnull(
        fv!item[3]
      ),
      len(
        fv!item[3]
      ) &lt;= 2
    ),
    local!transaction: 'type!{urn:com:appian:types:TM}TM_TransactionToken'(
      id: fv!item[2]
    ),
    'type!{urn:com:appian:types:TM}TM_TransactionStart'(
      modelId: local!modelId,
      context: if(
        local!isJsonEmpty,
        /* only pass transaction token */
        {
          transaction: local!transaction
        },
        /* add transaction token to existing context */
        #"SYSTEM_SYSRULES_fromJson_v1"(
          jsonText: left(
            fv!item[3],
            len(
              fv!item[3]
            ) - 1
          ) &amp; ", " &amp; """transaction"": " &amp; #"SYSTEM_SYSRULES_toJson_v1"(
            local!transaction
          ) &amp; "}"
        )
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>models</name>
            <type>
                <name>TM_ProcessModel?list</name>
                <namespace>urn:com:appian:types:TM</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>modelUuids</name>
            <type>
                <name>Text?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>transactionIds</name>
            <type>
                <name>Integer?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>contextJSONs</name>
            <type>
                <name>Text?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
