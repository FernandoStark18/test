    <rule>
        <name>TM_getBatchResult</name>
        <uuid>_a-0000ec76-910b-8000-9bcb-011c48011c48_14117</uuid>
        <description>Returns metadata and transaction starts details that inform the process which actions to perform after retrieving a batch.</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289262</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!resultSet: index(ri!ResultSets, 1, null),
  local!newBatchesWithoutDataCount: if(
    a!isNullOrEmpty(local!resultSet),
    index(ri!previousBatchResult, "batchesWithoutDataCount", 0) + 1,
    0
  ),
  local!sleepBackoffSec: intervalds(0, 0, min(power(#"_a-0000ec5e-d78c-8000-9bc5-011c48011c48_11749", local!newBatchesWithoutDataCount) * #"_a-0000e393-277a-8000-8592-01ef9001ef90_95319", #"_a-0000ec54-b070-8000-9bc1-011c48011c48_10873")),
  local!newSleepUntil: index(ri!previousBatchResult, "sleepUntil", now()) + local!sleepBackoffSec,
  a!map(
    transactionStarts: if(
      a!isNullOrEmpty(local!resultSet),
      {},
      #"_a-0000e398-8061-8000-8592-01ef9001ef90_104323"(
        models: ri!models,
        modelUuids: local!resultSet.model_uuid,
        transactionIds: local!resultSet.id,
        contextJSONs: local!resultSet.context_json
      )
    ),
    batchesWithoutDataCount: local!newBatchesWithoutDataCount,
    sleepUntil: if (local!newSleepUntil &lt;= now(), now() + intervalds(0, 0, #"_a-0000e393-277a-8000-8592-01ef9001ef90_95319"), local!newSleepUntil)
  )
)</definition>
