        </type>
        <value>
            <el>
                <a:name>Context Converted to JSON</a:name>
                <a:description/>
                <a:ruleInputTestConfigs>
                    <a:value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="a:Expression">'type!{urn:com:appian:types:TM}TM_QueueTransaction'(
  modelUuid: "uuid",
