<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e4d6-77d9-8000-8592-01ef9001ef90_107842</versionUuid>
    <rule>
        <name>TM_buildTransactionsFromQueue</name>
        <uuid>_a-0000e3cb-ddd3-8000-8592-01ef9001ef90_105144</uuid>
        <description>Builds TM_Transaction Objects Based On Job Type &amp; Queue</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289262</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!jobTypes: cast(
    'type!{urn:com:appian:types:TM}TM_JobType',
    #"_a-0000e3cb-ddd3-8000-8592-01ef9001ef90_105164"(
      modelUuids: ri!transactions.modelUuid
    ).data
  ),
  #"SYSTEM_SYSRULES_forEach"(
    items: ri!transactions,
    expression: 'type!{urn:com:appian:types:TM}TM_Transaction'(
      jobTypeId: displayvalue(
        fv!item.modelUuid,
        local!jobTypes.modelUuid,
        local!jobTypes.id,
        null
      ),
      contextJson: if(
        isnull(
          fv!item.context
        ),
        #"SYSTEM_SYSRULES_toJson_v1"(
          {}
        ),
        #"SYSTEM_SYSRULES_toJson_v1"(
          fv!item.context
        )
      ),
      scheduled: if(
        isnull(
          fv!item.scheduled
        ),
        now(),
        fv!item.scheduled
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>transactions</name>
            <type>
                <name>TM_QueueTransaction?list</name>
                <namespace>urn:com:appian:types:TM</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
