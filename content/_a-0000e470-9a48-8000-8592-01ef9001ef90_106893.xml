    <versionUuid>_a-0000ec6d-4ad8-8000-9bc9-011c48011c48_13684</versionUuid>
    <rule>
        <name>TM_isAppAdmin</name>
        <uuid>_a-0000e470-9a48-8000-8592-01ef9001ef90_106893</uuid>
        <description>Checks whether the logged in user is an application administrator</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289262</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>or(
  user(loggedInUser(), "userTypeName") = "Administrator",
  #"urn:appian:function:v1:a:isusermemberofgroup?okey=a!isUserMemberOfGroup"(
    username: loggedInUser(),
    groups: #"_a-0000e41e-1753-8000-9ba9-011c48011c48_3289247"
  )
)</definition>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
