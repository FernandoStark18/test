    <rule>
        <name>TM_shouldStopRunning</name>
        <uuid>_a-0000ec6d-4ad8-8000-9bc9-011c48011c48_12705</uuid>
        <description>Returns true if TM should stop running and shutdown gracefully. Returns false to keep running.</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289262</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>= or(
  /* stored proc errored, don't continue */
  ri!spErrorOccurred,
  /* TM is disabled */
  not(ri!isTmEnabled),
  /* reached 59 minute time limit */
  now() &gt; ri!processStartTime + intervalds(0, 59, 0),
  /* probably reached 990 loop limit */
  (now() - ri!processStartTime) / intervalds(0, 0, ri!batchSleepSec) &gt;= 998
)</definition>
        <namedTypedValue>
            <name>processStartTime</name>
            <type>
                <name>dateTime</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>spErrorOccurred</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>isTmEnabled</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>batchSleepSec</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
