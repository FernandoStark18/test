<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000ec7f-d3cb-8000-9bcd-011c48011c48_16092</versionUuid>
    <rule>
        <name>TM_getProcessModels</name>
        <uuid>_a-0000e3b8-7177-8000-8592-01ef9001ef90_104830</uuid>
        <description>Returns Existing Process Model Lookup Values</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289282</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!isModelUuidsPresent: a!isNotNullOrEmpty(ri!modelUuids),
  local!batchSize: if(
    local!isModelUuidsPresent,
    count(ri!modelUuids),
    0 /* Default to 0 if no relevant model UUIDs in the tm_job_type DB table */
  ),
  local!result: a!queryProcessAnalytics( /* replace the report by checking the tm_job_type table? */
    report: #"_a-0000e3b8-7177-8000-8592-01ef9001ef90_104819",
    query: #"SYSTEM_SYSRULES_query"(
      pagingInfo: #"SYSTEM_SYSRULES_pagingInfo"(
        startIndex: 1,
        batchSize: local!batchSize,
        sort: #"SYSTEM_SYSRULES_sortInfo"(
          field: "c1", /* ID */
          ascending: true
        )
      ),
      filter: #"SYSTEM_SYSRULES_queryFilter"(
        field: "c2", /* UUID */
        operator: "in",
        value: ri!modelUuids,
        applyWhen: local!isModelUuidsPresent
      )
    )
  ),

  if(
    a!isNullOrEmpty(local!result.identifiers), /* merge() will throw an error on empty input */
    null,
    #"SYSTEM_SYSRULES_forEach"(
      items: merge(
        local!result.identifiers,
        local!result.data.c2,
        local!result.data.c0
      ),
      expression: 'type!{urn:com:appian:types:TM}TM_ProcessModel'(
        id: fv!item[1],
        uuid: fv!item[2],
        name: fv!item[3]
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>modelUuids</name>
            <type>
                <name>Text?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
