    <rule>
        <name>TM_setProcessDisplayName</name>
        <uuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289405</uuid>
        <description>Common Utility To Set Process Display Name (+Monitoring)</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289262</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  and(
    a!isNullOrEmpty(
      ri!modelName
    ),
    a!isNullOrEmpty(
      ri!entityName
    ),
    a!isNullOrEmpty(
      ri!id
    )
  ),
  "No Inputs Provided - Please Rectify",
  concat(
    ri!modelName,
    if(
      a!isNullOrEmpty(
        ri!entityName
      ),
      " " &amp; ri!id,
      " " &amp; ri!entityName &amp; " " &amp; ri!id
    )
  )
)</definition>
        <namedTypedValue>
            <name>entityName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>modelName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>id</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
