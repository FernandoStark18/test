<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000ec54-b070-8000-9bc1-011c48011c48_10872</versionUuid>
    <rule>
        <name>TM_buildTransactionStatuesFromFailedTransactionStarts</name>
        <uuid>_a-0000e398-8061-8000-8592-01ef9001ef90_104411</uuid>
        <description>Returns Transactions That Failed In Start Processes</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289262</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!transactionIds: ri!transactionStarts.context.transaction.id,
  local!allIndexes: enumerate(
    count(
      local!transactionIds
    )
  ) + 1,
  local!indexesNotStarted: symmetricdifference(
    local!allIndexes,
    ri!indexesStarted
  ),
  #"SYSTEM_SYSRULES_forEach"(
    items: index(
      ri!transactionStarts.context.transaction.id,
      local!indexesNotStarted
    ),
    expression: 'type!{urn:com:appian:types:TM}TM_TransactionStatus'(
      id: fv!item,
      statusId: #"_a-0000e398-8061-8000-8592-01ef9001ef90_104405"
    )
  )
)</definition>
        <namedTypedValue>
            <name>transactionStarts</name>
            <type>
                <name>TM_TransactionStart?list</name>
                <namespace>urn:com:appian:types:TM</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>indexesStarted</name>
            <type>
                <name>Integer?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
