        <definition>a!localVariables(
  local!result: a!queryProcessAnalytics(
    report: #"_a-0000e3b8-7177-8000-8592-01ef9001ef90_104819",
    /*
    c0 = Model Name
    c1 = Model Id
    c2 = Model UUID
    */
    query: #"SYSTEM_SYSRULES_query"(
      filter: #"SYSTEM_SYSRULES_queryFilter"(
        field: "c0",
        operator: "includes",
        value: ri!filter
      ),
      pagingInfo: #"SYSTEM_SYSRULES_pagingInfo"(
        startIndex: 1,
        batchSize: 10,
        sort: #"SYSTEM_SYSRULES_sortInfo"(field: "c0", ascending: true)
      )
    )
  ),
  #"SYSTEM_SYSRULES_dataSubset"(
    startIndex: local!result.startIndex,
    batchSize: local!result.batchSize,
    totalCount: local!result.totalCount,
    data: index(local!result.data, "c0", {}),
    identifiers: index(local!result.data, "c2", {})
  )
)</definition>
