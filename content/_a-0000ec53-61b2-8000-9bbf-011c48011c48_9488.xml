<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000ec53-61b2-8000-9bbf-011c48011c48_9508</versionUuid>
    <rule>
        <name>TM_calculateTransactionsToStartPerJobType</name>
        <uuid>_a-0000ec53-61b2-8000-9bbf-011c48011c48_9488</uuid>
        <description>Calculate the ideal number of transactions to start for each job type</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289262</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>/*
IMPORTANT: ri!remainingSortedJobTypes MUST be sorted by startableCount ascending

This *recursive* expression calculates the ideal number of transactions to start for each job type.

It has to work with several constraints:
1. Number of Job Types is not static
2. Each Job Type will be able to accomidate a different number of transactions (currently running vs max running allowed)
3. The batch size won't divide equally across the job types
*/
a!match(
  value: count(ri!remainingSortedJobTypes),

  /* batch size is smaller than available job types. randomly choose job types to avoid always picking the same ones */
  whenTrue: fv!value &gt; ri!remainingBatchSize,
  then: a!localVariables(
    local!shuffledJobTypeIndexes: todatasubset(
      #"SYSTEM_SYSRULES_forEach"(
        items: ri!remainingSortedJobTypes,
        expression: {
          sort: rand(),
          index: fv!index
        }
      ),
      #"SYSTEM_SYSRULES_pagingInfo"(
        startIndex: 1,
        batchSize: -1,
        sort: #"SYSTEM_SYSRULES_sortInfo"(
          field:"sort",
          ascending: true
        )
      )
    ).data.index,
    local!indexesToReturn: tointeger(rdrop(local!shuffledJobTypeIndexes, count(ri!remainingSortedJobTypes) - ri!remainingBatchSize)),
    #"SYSTEM_SYSRULES_forEach"(
      items: ri!remainingSortedJobTypes,
      expression: if(contains(local!indexesToReturn, fv!index), 1, 0)
    )
  ),

  /* recursively distribute the available batch among the job types */
  whenTrue: fv!value &gt; 0,
  then: a!localVariables(
    local!couldStart: floor(
      ri!remainingBatchSize / count(ri!remainingSortedJobTypes)
    ),
    local!willStart: min(
      local!couldStart,
      ri!remainingSortedJobTypes[1][#"urn:appian:record-field:v1:bb2a66ad-ea4d-439b-afbc-703858c5c12a/maxAllowedToStart"]
    ),
    #"_a-0000ec53-61b2-8000-9bbf-011c48011c48_9488"(
      remainingSortedJobTypes: ldrop(ri!remainingSortedJobTypes, 1),
      remainingBatchSize: ri!remainingBatchSize - local!willStart,
      results: append(ri!results, local!willStart)
    )
  ),

  /* return the final result */
  default: ri!results
)</definition>
