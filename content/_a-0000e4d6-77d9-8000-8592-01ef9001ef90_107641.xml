<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e4d6-77d9-8000-8592-01ef9001ef90_107804</versionUuid>
    <rule>
        <name>TM_getCapacityUsed</name>
        <uuid>_a-0000e4d6-77d9-8000-8592-01ef9001ef90_107641</uuid>
        <description>Calculates the percentage capacity used</description>
        <parentUuid>_a-0000e41e-1753-8000-9ba9-011c48011c48_3289262</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!totalCount: ri!runningCount + ri!failedCount,
  local!capacityUsed: if(
    local!totalCount = 0,
    0,
    if(
      local!totalCount &gt; ri!maxRunning,
      100,
      (
        local!totalCount / ri!maxRunning * 100
      )
    )
  ),
  local!capacityUsed
)</definition>
        <namedTypedValue>
            <name>runningCount</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>failedCount</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>maxRunning</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
